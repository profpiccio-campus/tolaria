		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01o\x00\x00\x00Z\x00\x00\x04\x90\x00\x00\x02\xb8\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x8f\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'out_data = in_data.to_dense()\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf9\x00\x00\x06\x00\x00\x00\x030\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xff\x00\x00\x03/', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="12" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01p\x00\x00\x00Z\x00\x00\x04\x9d\x00\x00\x02\xb7\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x9d\x00\x00\x02\xb7\x00\x00\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x01p\x00\x00\x00x\x00\x00\x04\x9d\x00\x00\x02\xb7', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, StringVariable\n\nNOME_CLASSE = "categoria"      # nome della colonna nel file\nETICHETTA_TEST = "nuovo"       # etichetta dei testi da classificare\n\ndom_in = in_data.domain\nvar = dom_in[NOME_CLASSE]\n\n# etichette di ogni riga come stringhe, ovunque si trovi la colonna\ncol = np.asarray(in_data.get_column(var))\nif var.is_discrete:\n    etichette = np.array([\n        var.values[int(v)] if not np.isnan(float(v)) else "?" for v in col\n    ])\nelse:\n    etichette = np.array([str(v) for v in col])\n\n# matrice delle parole, escludendo la colonna categoria se è tra le feature\nX = in_data.X\nif hasattr(X, "toarray"):\n    X = X.toarray()\nX = np.asarray(X, dtype=float)\ntieni = [i for i, a in enumerate(dom_in.attributes) if a.name != NOME_CLASSE]\nX = X[:, tieni]\n\ncategorie = []\nfor e in etichette:\n    if e not in categorie and e not in (ETICHETTA_TEST, "?", "nan"):\n        categorie.append(e)\n\nis_test = etichette == ETICHETTA_TEST\ncentroidi = np.array([X[etichette == c].mean(axis=0) for c in categorie])\ntest = X[is_test]\n\ndist = np.array([[np.linalg.norm(t - c) for c in centroidi] for t in test])\npred = [categorie[i] for i in dist.argmin(axis=1)]\n\n# testo originale: prima meta di tipo stringa diversa da categoria\nmetas_str = [i for i, m in enumerate(dom_in.metas)\n             if m.is_string and m.name != NOME_CLASSE]\ntesti = in_data.metas[is_test][:, metas_str[0]]\n\ndom = Domain(\n    [ContinuousVariable("dist_" + c) for c in categorie],\n    metas=[StringVariable("testo"), StringVariable("categoria_assegnata")],\n)\nmetas = np.array([[str(t), p] for t, p in zip(testi, pred)], dtype=object)\nout_data = Table.from_numpy(dom, dist, metas=metas)\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\xa1\x00\x00\x00a\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
